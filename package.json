{
  "name": "gemini-coder",
  "displayName": "Gemini Coder",
  "description": "AI Code Assistant using Google Gemini API",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aibot.openChat",
        "title": "Gemini Coder: Open Chat"
      }
    ],
    "configuration": {
      "title": "Gemini Coder",
      "properties": {
        "aibot.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "API Key for Google Gemini API"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.2.5",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^2.3.2",
    "dotenv": "^16.6.1",
    "eslint": "^8.41.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^5.1.3"
  }
}
